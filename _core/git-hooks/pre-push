#!/usr/bin/env bash
# =============================================================================
# Global pre-push dispatcher
# =============================================================================
# Behaviour:
#   1. If the repo ships `.githooks/pre-push`, delegate to it (exec) and stop.
#   2. Otherwise, for Synforger (and no-remote fail-safe) repos, parse stdin
#      ref ranges and run `.tooling/local-ci/anon-audit-deep.sh --range` on
#      each outgoing commit range. Missing scanner = hard fail.
#   3. Other repos are a no-op after the delegation check.
#
# stdin format (per git hooks docs):
#   <local-ref> SP <local-sha> SP <remote-ref> SP <remote-sha> LF
# A remote-sha of all zeros = new branch on the remote.
# A local-sha  of all zeros = branch delete (skipped, no diff to scan).
#
# Range calculation:
#   normal push  — <remote-sha>..<local-sha>
#   new branch   — origin/<default>..<local-sha>
#                  (approximation: scans the delta from the repo's default
#                   branch, since the remote has no ref yet. Covers the
#                   common feature-branch push. Truly disjoint histories
#                   fall back to full mode via task audit:deep.)
# =============================================================================
set -eu

# shellcheck source=lib/dispatcher-common.sh
. "$(dirname "$0")/lib/dispatcher-common.sh"

dispatcher::delegate_if_present "pre-push" "$@"

kind="$(dispatcher::detect_repo_kind)"
if [ "${kind}" = "other" ]; then
    exit 0
fi

scanner="$(dispatcher::locate_deep_scanner || true)"
if [ -z "${scanner}" ]; then
    cat >&2 <<'MSG'
[pre-push] anon-audit-deep.sh is missing from this repo.
           Expected at: .tooling/local-ci/anon-audit-deep.sh
           The global dispatcher refuses pushes on Synforger repos that
           have not installed their local anon toolkit. Install it from
           personal-template `_core/.tooling/local-ci/` or run
           `task install:core` if the repo uses the Taskfile flow.
MSG
    exit 1
fi

zero='0000000000000000000000000000000000000000'
default_branch="$(dispatcher::default_branch)"
any_leak=0

# git feeds pre-push lines through stdin. Read until EOF so an empty push
# (no matching refspec) just falls through and exits 0.
while read -r local_ref local_sha remote_ref remote_sha; do
    [ -z "${local_ref}" ] && continue

    # delete push — nothing outgoing to scan
    if [ "${local_sha}" = "${zero}" ]; then
        continue
    fi

    if [ "${remote_sha}" = "${zero}" ]; then
        # new remote branch — scan the delta from origin/<default>
        revspec="origin/${default_branch}..${local_sha}"
        if ! git rev-parse "origin/${default_branch}" >/dev/null 2>&1; then
            # No local ref for the default branch (fresh clone edge case) —
            # fall back to scanning the single tip commit.
            revspec="${local_sha}"
        fi
    else
        revspec="${remote_sha}..${local_sha}"
    fi

    printf '[pre-push] anon-audit-deep --range %s (ref %s)\n' "${revspec}" "${local_ref}" >&2
    if ! bash "${scanner}" --range "${revspec}"; then
        any_leak=1
    fi
done

exit "${any_leak}"
